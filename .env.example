# Bu dosya şablondur, değer içermez. Sunucuda karşılığı .env.local + .env.production.
# DİKKAT: API adresi sunucuda .env.LOCAL içinde duruyor — adı "local" olsa da
# üretimde kullanılıyor. Sunucu taşırken sadece .env.production'ı kopyalamak
# yetmez, bu dosya atlanırsa build hata verir (src/lib/apiBase.ts).

# Zorunlu — yoksa üretim build'i patlar
NEXT_PUBLIC_API_URL=https://motorya.com.tr/api-backend

# Sunucu sayfalari uretirken kullandigi ic adres. Bu olmadan sunucu kendi genel
# adresine gidiyor, yani istek Cloudflare'e cikip donuyor ve kenar kurallarina
# takilabiliyor (Turkiye disi dogrulama kurali tam olarak bunu kirdi).
INTERNAL_API_URL=http://127.0.0.1:3000

# Bot doğrulama (kayıt/giriş formları)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Hata takibi
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Reklam birimleri
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG=
